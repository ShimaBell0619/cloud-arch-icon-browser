{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src/cli",
    "outDir": "cli",
    "noEmit": false,
    "noEmitOnError": true
  },
  "include": ["src/cli/**/*.ts"],
  "exclude": ["src/cli/**/*.test.ts"]
}
