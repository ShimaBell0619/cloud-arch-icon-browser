{
  "name": "@shimabell06/cloud-arch-icon-browser",
  "version": "0.2.0",
  "private": false,
  "description": "A local browser for user-provided architecture icon packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShimaBell0619/cloud-arch-icon-browser.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cloud-arch-icon-browser": "cli/index.js"
  },
  "files": [
    "cli",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test tests/e2e/visual.spec.mjs --update-snapshots",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "node scripts/clean-build.mjs && npm run typecheck && vite build && npm run build:cli",
    "preview": "vite preview",
    "test:cli-smoke": "node scripts/cli-smoke.mjs",
    "test:cli-package-smoke": "node scripts/cli-package-smoke.mjs",
    "verify:package": "node scripts/validate-package.mjs",
    "verify:official": "node scripts/verify-official.mjs",
    "verify:release-ready": "node scripts/validate-release-ready.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@zip.js/zip.js": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuse.js": "7.5.0",
    "lucide-react": "1.41.0",
    "open": "11.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
